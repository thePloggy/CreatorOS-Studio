{
 "unet": {
  "class_type": "UNETLoader",
  "inputs": {
   "unet_name": "acestep_v1.5_turbo.safetensors",
   "weight_dtype": "default"
  }
 },
 "ms": {
  "class_type": "ModelSamplingAuraFlow",
  "inputs": {
   "model": [
    "unet",
    0
   ],
   "shift": 3
  }
 },
 "clip": {
  "class_type": "DualCLIPLoader",
  "inputs": {
   "clip_name1": "qwen_0.6b_ace15.safetensors",
   "clip_name2": "qwen_4b_ace15.safetensors",
   "type": "ace",
   "device": "default"
  }
 },
 "vae": {
  "class_type": "VAELoader",
  "inputs": {
   "vae_name": "ace_1.5_vae.safetensors"
  }
 },
 "txt": {
  "class_type": "TextEncodeAceStepAudio1.5",
  "inputs": {
   "clip": [
    "clip",
    0
   ],
   "tags": "ambient soundscape, field recording, no music, no vocals, {{lieu}}",
   "lyrics": "[instrumental]",
   "seed": "{{seed}}",
   "bpm": 90,
   "duration": "{{secondes}}",
   "timesignature": "4",
   "language": "en",
   "keyscale": "C major",
   "generate_audio_codes": true,
   "cfg_scale": 2,
   "temperature": 0.85,
   "top_p": 0.9,
   "top_k": 0,
   "min_p": 0
  }
 },
 "neg": {
  "class_type": "ConditioningZeroOut",
  "inputs": {
   "conditioning": [
    "txt",
    0
   ]
  }
 },
 "lat": {
  "class_type": "EmptyAceStep1.5LatentAudio",
  "inputs": {
   "seconds": "{{secondes}}",
   "batch_size": 1
  }
 },
 "k": {
  "class_type": "KSampler",
  "inputs": {
   "seed": "{{seed}}",
   "steps": 8,
   "cfg": 1,
   "sampler_name": "euler",
   "scheduler": "simple",
   "denoise": 1,
   "model": [
    "ms",
    0
   ],
   "positive": [
    "txt",
    0
   ],
   "negative": [
    "neg",
    0
   ],
   "latent_image": [
    "lat",
    0
   ]
  }
 },
 "dec": {
  "class_type": "VAEDecodeAudio",
  "inputs": {
   "samples": [
    "k",
    0
   ],
   "vae": [
    "vae",
    0
   ]
  }
 },
 "save": {
  "class_type": "SaveAudioMP3",
  "inputs": {
   "audio": [
    "dec",
    0
   ],
   "filename_prefix": "extension",
   "quality": "V0"
  }
 }
}
